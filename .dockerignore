# File này quyết định thứ KHÔNG được copy vào build context / image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Git & CI
.git
.gitignore
.github

# Secret — tuyệt đối không vào image
.env
.env.*
!.env.example

# Môi trường ảo & cache Python
.venv
venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache

# Không cần lúc chạy
tests
screenshots
*.md
grade.py
docker-compose.yml
nginx
railway.toml
render.yaml

# Editor / OS
.vscode
.idea
.DS_Store
